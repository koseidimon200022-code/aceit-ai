# Copy this file to .env ONLY for local testing.
# On Render, set these values in the Render dashboard (Environment) instead — never commit the real key.

# Google Gemini API key (required). Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY_WWW=your_gemini_api_key_here

# Optional overrides
# GEMINI_MODEL=gemini-3.6-flash
# PORT=8787